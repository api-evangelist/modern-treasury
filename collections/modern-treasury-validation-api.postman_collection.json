          "name": "validate routing numbers",
          "request": {
            "name": "validate routing numbers",
            "description": {
              "content": "Validates the routing number information supplied without creating a routing detail",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "validations",
                "routing_numbers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "routing_number",
                  "value": "<string>",
                  "description": "(Required) The routing number that is being validated."
                },
                {
                  "disabled": false,
                  "key": "routing_number_type",
                  "value": "<string>",
                  "description": "(Required) The type of routing number. See https://docs.moderntreasury.com/platform/reference/routing-detail-object for more details. In sandbox mode we currently only support `aba` and `swift` with routing numbers '123456789' and 'GRINUST0XXX' respectively."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",

            "method": "PUT",
            "url": "http://localhost:3000/api/invoices/:id/payment_orders/:payment_order_id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "id"
              },
              {
                "name": "payment_order_id",
                "value": "",
                "type": "path",
                "description": "payment_order_id"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Add a payment order to an invoice."
        },
        {
          "info": {
            "name": "create async payment order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:3000/api/payment_orders/create_async",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
